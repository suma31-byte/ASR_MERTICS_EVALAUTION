# Never commit the dataset or the audio.
# The corpus is ~5.4 GB. GitHub rejects files over 100 MB, and a large file
# committed once stays in the history forever.
combined/
dataset/
audio/
*.wav
*.mp3
*.flac
dataset_v*.csv
metadata*.csv
manifest*.csv

# Run output
results_detailed*.csv
full_metrics_*.csv
batch_results_*.csv
report_*.xlsx
summary*.json
smartscribe_asr_eval_*.txt
batch_*_size*.txt
status.json
status.json.tmp
stop.request
run.log
run_*.json

# Local machine state
calibration.json
calibration_screenshot.png
_window_dump.xml
ui_map.json
eval_out/
audio_cache/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.coverage
*.egg-info/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
